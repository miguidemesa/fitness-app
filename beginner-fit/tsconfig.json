{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/utils/*": [
        "./supabase/functions/_shared/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": ["supabase/functions/*/index.ts"]
}
